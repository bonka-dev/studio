{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bonka.dev/schema/input-map-v1.json",
  "title": "Bonka Input Map v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "type", "id", "name", "actions"],
  "properties": {
    "formatVersion": { "const": 1 },
    "type": { "const": "inputMap" },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "createdWith": { "$ref": "#/definitions/createdWith" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/definitions/action" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "createdWith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bonka"],
      "properties": {
        "bonka": { "type": "string", "minLength": 1 }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bindings"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/gbaDigitalBinding" }
        }
      }
    },
    "gbaDigitalBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "control", "trigger"],
      "properties": {
        "platform": { "const": "gba" },
        "control": {
          "enum": ["up", "down", "left", "right", "a", "b", "l", "r", "start", "select"]
        },
        "trigger": { "enum": ["held", "pressed", "released"] }
      }
    }
  }
}
