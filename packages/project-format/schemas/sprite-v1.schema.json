{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bonka.dev/schema/sprite-v1.json",
  "title": "Bonka Sprite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "type", "id", "source", "frameSize", "frameCount", "animations", "gba"],
  "properties": {
    "formatVersion": { "const": 1 },
    "type": { "const": "sprite" },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "createdWith": { "$ref": "#/definitions/createdWith" },
    "source": { "$ref": "#/definitions/portablePath" },
    "frameSize": { "$ref": "#/definitions/size" },
    "frameCount": { "type": "integer", "minimum": 1 },
    "layout": { "$ref": "#/definitions/layout" },
    "authoring": { "$ref": "#/definitions/authoring" },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" }
      }
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": { "$ref": "#/definitions/animation" }
    },
    "directionalSets": {
      "type": "array",
      "items": { "$ref": "#/definitions/directionalSet" }
    },
    "gba": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "bpp"],
      "properties": {
        "colors": { "enum": [16, 256] },
        "bpp": { "enum": [4, 8] },
        "priority": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "createdWith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bonka"],
      "properties": {
        "bonka": { "type": "string", "minLength": 1 }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageWidth", "imageHeight", "columns", "rows", "margin", "spacing"],
      "properties": {
        "imageWidth": { "type": "integer", "minimum": 1 },
        "imageHeight": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "margin": { "$ref": "#/definitions/offset" },
        "spacing": { "$ref": "#/definitions/offset" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loop", "frames"],
      "properties": {
        "loop": { "type": "boolean" },
        "frames": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "duration"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "duration": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "layout": { "$ref": "#/definitions/layout" }
      }
    },
    "directionalSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "variants"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/directionalVariant" }
        }
      }
    },
    "directionalVariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["angle", "animation"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "angle": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "animation": { "$ref": "#/definitions/id" }
      }
    },
    "authoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "width", "height", "layers"],
      "properties": {
        "version": { "const": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "palette": {
          "type": "array",
          "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/authoringLayer" }
        }
      }
    },
    "authoringLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "visible", "kind", "pixels"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "visible": { "type": "boolean" },
        "kind": { "enum": ["drawing", "reference"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" }
          }
        },
        "pixels": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "null" },
              { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            ]
          }
        }
      }
    }
  }
}
