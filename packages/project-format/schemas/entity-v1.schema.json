{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bonka.dev/schema/entity-v1.json",
  "title": "Bonka Entity Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "type", "id", "name", "components"],
  "properties": {
    "formatVersion": { "const": 1 },
    "type": { "const": "entity" },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "createdWith": { "$ref": "#/definitions/createdWith" },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sprite": { "$ref": "#/definitions/spriteComponent" },
        "collider": { "$ref": "#/definitions/colliderComponent" },
        "behavior": { "$ref": "#/definitions/behaviorComponent" }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "createdWith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bonka"],
      "properties": {
        "bonka": { "type": "string", "minLength": 1 }
      }
    },
    "spriteComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset"],
      "properties": {
        "asset": { "$ref": "#/definitions/id" },
        "animation": { "$ref": "#/definitions/id" },
        "directionalSet": { "$ref": "#/definitions/id" }
      },
      "oneOf": [
        {
          "required": ["animation"],
          "properties": { "animation": { "$ref": "#/definitions/id" } }
        },
        {
          "required": ["directionalSet"],
          "properties": { "directionalSet": { "$ref": "#/definitions/id" } }
        }
      ]
    },
    "colliderComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "width", "height"],
      "properties": {
        "shape": { "const": "box" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "behaviorComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "inputActions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/id" }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          }
        }
      }
    }
  }
}
