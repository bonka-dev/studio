{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bonka.dev/schema/tileset-v1.json",
  "title": "Bonka Tileset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "type", "id", "name", "source", "tileSize", "layout", "metatiles"],
  "properties": {
    "formatVersion": { "const": 1 },
    "type": { "const": "tileset" },
    "id": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1 },
    "createdWith": { "$ref": "#/definitions/createdWith" },
    "source": { "$ref": "#/definitions/portablePath" },
    "tileSize": { "$ref": "#/definitions/size" },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageWidth", "imageHeight", "columns", "tileCount", "margin", "spacing"],
      "properties": {
        "imageWidth": { "type": "integer", "minimum": 1 },
        "imageHeight": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "tileCount": { "type": "integer", "minimum": 1 },
        "margin": { "type": "integer", "minimum": 0 },
        "spacing": { "type": "integer", "minimum": 0 }
      }
    },
    "metatiles": {
      "type": "array",
      "items": { "$ref": "#/definitions/metatile" }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "portablePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "createdWith": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bonka"],
      "properties": {
        "bonka": { "type": "string", "minLength": 1 }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "metatile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "columns", "rows", "visible", "opacity", "tiles", "collision"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "name": { "type": "string", "minLength": 1 },
        "columns": { "type": "integer", "minimum": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "visible": { "type": "boolean" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "tiles": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "null" },
              { "type": "integer", "minimum": 0 }
            ]
          }
        },
        "collision": {
          "type": "array",
          "items": { "enum": [0, 1] }
        }
      }
    }
  }
}
